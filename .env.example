# ─── LLM reasoning layer (cloud APIs during the hackathon) ────────────────────

# API key for Mistral models. Also used for Pixtral vision OCR.
MISTRAL_API_KEY=your_mistral_api_key

# API key for Groq (fallback when Mistral is unavailable). Optional --
# leave it empty and an outage simply surfaces as an unsourced answer.
GROQ_API_KEY=

# Open-weight (Apache-2.0) multimodal model used for document OCR, chosen over
# Mistral's proprietary OCR product so the pipeline stays self-hostable.
# NOTE: Pixtral is RETIRED from the Mistral API (pixtral-12b-2409 retired
# 2025-12-02, pixtral-large-2411 retired 2026-02-27). We use its open-weight
# successors instead; ministral-8b-2512 is the lightweight self-hosting target.
# Leave unset to let Sahilli pick the best available model at runtime.
# Verified available: ministral-14b-2512 (Apache-2.0, open-weight, vision).
VISION_MODEL=ministral-14b-2512


# ─── Self-hosted AI infrastructure ───────────────────────────────────────────
# Both defaults below were detected from containers already running on this
# machine via `docker ps -a` + `docker inspect`:
#
#   qdrant/qdrant:v1.15.1
#     -> host port 6333 (HTTP API) / 6334 (gRPC)
#   ghcr.io/huggingface/text-embeddings-inference:86-1.8
#     -> launched with `--model-id BAAI/bge-m3 --port 80`, published on host 8090
#
# Change these if your own containers expose different ports.

# Self-hosted Qdrant vector database. Leave blank to use an in-memory store.
QDRANT_URL=http://localhost:6333

# Self-hosted BGE-M3 embedding server (HuggingFace Text Embeddings Inference).
# Sahilli calls its native POST /embed endpoint.
EMBEDDING_SERVICE_URL=http://localhost:8090

# Vector width emitted by BGE-M3. Must match the Qdrant collection's config.
EMBEDDING_DIM=1024


# ─── Frontend ────────────────────────────────────────────────────────────────

# Public URL used by the browser to reach FastAPI
NEXT_PUBLIC_API_URL=http://localhost:8000

# ─── Accounts (Postgres) ─────────────────────────────────────────────────────
# Matches the postgres service in docker-compose.yml (profile: infra).
# Pointing at a Postgres you already run is fine -- change the credentials here.
# (host port 5432). Sahilli uses its own database on that server; the
# `sahilli_test` database is used by the test suite.

DATABASE_URL=postgresql+asyncpg://sahilli:sahilli@localhost:5432/sahilli
TEST_DATABASE_URL=postgresql+asyncpg://sahilli:sahilli@localhost:5432/sahilli_test

# Signing key for session tokens. MUST be replaced outside local development:
# the default below is in the repository, so anyone could mint a valid session.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=sahilli-local-development-secret-do-not-use-in-production
SESSION_TTL_HOURS=12

# Set to true wherever the site is served over HTTPS.
COOKIE_SECURE=false

# ─── Security ────────────────────────────────────────────────────────────────

# Comma-separated allowed browser origins. No wildcards: credentials are sent
# with every request and "*" plus credentials is not permitted.
CORS_ORIGINS=http://localhost:3000

# Only enable behind a real reverse proxy. Otherwise any client could spoof
# X-Forwarded-For and evade rate limiting by rotating it.
TRUST_PROXY_HEADERS=false

# ---------------------------------------------------------------- storage ---
# Uploaded documents. Leave S3_ENDPOINT_URL empty to keep them on the
# filesystem under data/raw, which is what a clone without MinIO gets.
# Reads fall back to the filesystem either way, so dossiers filed before the
# bucket existed keep opening.
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=sahilli-documents
S3_REGION=us-east-1

# ------------------------------------------------------------- host ports ---
# Only read by docker-compose.yml, and only when the `infra` profile is up.
# Change one if something on this machine already holds the default.
# BACKEND_PORT=8000
# FRONTEND_PORT=3000
# POSTGRES_PORT=5432
# QDRANT_PORT=6333
# QDRANT_GRPC_PORT=6334
# EMBEDDING_PORT=8090
# MINIO_PORT=9000
# MINIO_CONSOLE_PORT=9001
