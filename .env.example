# ─── LLM reasoning layer (cloud APIs during the hackathon) ────────────────────

# API key for Mistral models. Also used for Pixtral vision OCR.
MISTRAL_API_KEY=your_mistral_api_key

# API key for Google Gemini models (fallback when Mistral is unavailable).
GEMINI_API_KEY=your_gemini_api_key

# Vision model used for document OCR. Pixtral is Apache-2.0 / open-weight,
# unlike Mistral's proprietary OCR product. See app/services/ocr_service.py.
PIXTRAL_MODEL=pixtral-12b-2409


# ─── Self-hosted AI infrastructure ───────────────────────────────────────────
# Both defaults below were detected from containers already running on this
# machine via `docker ps -a` + `docker inspect`:
#
#   qdrant/qdrant:v1.15.1
#     -> host port 6333 (HTTP API) / 6334 (gRPC)
#   ghcr.io/huggingface/text-embeddings-inference:86-1.8
#     -> launched with `--model-id BAAI/bge-m3 --port 80`, published on host 8090
#
# Change these if your own containers expose different ports.

# Self-hosted Qdrant vector database. Leave blank to use an in-memory store.
QDRANT_URL=http://localhost:6333

# Self-hosted BGE-M3 embedding server (HuggingFace Text Embeddings Inference).
# Sahilli calls its native POST /embed endpoint.
EMBEDDING_SERVICE_URL=http://localhost:8090

# Vector width emitted by BGE-M3. Must match the Qdrant collection's config.
EMBEDDING_DIM=1024


# ─── Frontend ────────────────────────────────────────────────────────────────

# Public URL used by the browser to reach FastAPI
NEXT_PUBLIC_API_URL=http://localhost:8000
